Options -MultiViews
RewriteEngine On
RewriteBase /

# Ensure directory requests have trailing slash so index.html is served automatically
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.*[^/])$ /$1/ [L,R=301]

# If file exists, serve it
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# If folder exists, serve index.html
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^ - [L]

# Custom 404
ErrorDocument 404 /404.html
